        "section": [
          { "title": "Subjective", "text": { "status": "generated", "div": "<div xmlns=\"http://www.w3.org/1999/xhtml\">26-year-old woman with ADHD, combined type, returning for 6-week follow-up on lisdexamfetamine 40 mg. Improved morning focus and task initiation with a mid-afternoon rebound (restlessness, breakthrough anxiety) around 3 PM. Sleep adequate, appetite stable, denies palpitations or chest pain.</div>" } },
          { "title": "Objective", "text": { "status": "generated", "div": "<div xmlns=\"http://www.w3.org/1999/xhtml\">Attentive and organized on video exam; no agitation. Home vitals: HR 78, BP 118/74. Prescription drug monitoring program reviewed: consistent with prescribing, no aberrancy.</div>" } },
          { "title": "Assessment", "text": { "status": "generated", "div": "<div xmlns=\"http://www.w3.org/1999/xhtml\">ADHD, combined type: good morning response with an afternoon coverage gap. Cardiovascular parameters within normal limits.</div>" } },
          { "title": "Plan", "text": { "status": "generated", "div": "<div xmlns=\"http://www.w3.org/1999/xhtml\">Continue lisdexamfetamine 40 mg every morning. Add methylphenidate 10 mg early afternoon for coverage; prior authorization required before dispensing. Continue home HR/BP monitoring. Recheck in 4 to 6 weeks.</div>" } }
